---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profile - Service Collections">
  <div class="py-10"
       x-data="{
         editMode: false,
         editingSection: null,
         tempUserData: {},

         init() {
           this.tempUserData = { ...$store.auth.user };
         },

         startEdit(section) {
           this.editingSection = section;
           this.editMode = true;
           this.tempUserData = { ...$store.auth.user };
         },

         cancelEdit() {
           this.editMode = false;
           this.editingSection = null;
           this.tempUserData = { ...$store.auth.user };
         },

         async saveProfile() {
           try {
             console.log('💾 Saving profile...', this.tempUserData);

             // Get fresh token from auth store
             const token = $store.auth.token;
             if (!token) {
               console.error('❌ No authentication token available');
               alert('Authentication required. Please log in again.');
               return;
             }

             const response = await fetch('/api/auth/profile', {
               method: 'PUT',
               headers: {
                 'Content-Type': 'application/json',
                 'Authorization': `Bearer ${token}`
               },
               body: JSON.stringify(this.tempUserData)
             });

             console.log('📡 Profile update response status:', response.status);

             if (response.ok) {
               const updatedUser = await response.json();
               console.log('✅ Updated user data:', updatedUser);

               // Update the auth store with new user data
               $store.auth.user = updatedUser;
               this.editMode = false;
               this.editingSection = null;

               console.log('✅ Profile updated successfully');
               alert('Profile updated successfully!');
             } else {
               const errorData = await response.text();
               console.error('❌ Server error:', response.status, errorData);

               if (response.status === 401) {
                 alert('Authentication expired. Please log in again.');
                 $store.auth.logout();
               } else {
                 alert('Failed to update profile. Please try again.');
               }
             }
           } catch (error) {
             console.error('❌ Network error updating profile:', error);
             alert('Network error. Please check your connection and try again.');
           }
         }
       }">

    <!-- Profile Header -->
    <header class="bg-white shadow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="py-6 md:flex md:items-center md:justify-between">
          <div class="flex-1 min-w-0">
            <div class="flex items-center">
              <!-- Profile Avatar -->
              <div class="flex-shrink-0">
                <div class="h-20 w-20 rounded-full overflow-hidden shadow-lg"
                     x-show="$store.auth.user?.avatar_url">
                  <img :src="$store.auth.user?.avatar_url"
                       :alt="$store.auth.user?.first_name + ' ' + $store.auth.user?.last_name"
                       class="h-20 w-20 object-cover">
                </div>
                <div class="h-20 w-20 rounded-full bg-gradient-to-r from-primary-400 to-primary-600 flex items-center justify-center shadow-lg"
                     x-show="!$store.auth.user?.avatar_url">
                  <span class="text-2xl font-bold text-white" x-text="$store.auth.user?.first_name?.[0] + ($store.auth.user?.last_name?.[0] || '')"></span>
                </div>
              </div>

              <!-- Profile Info -->
              <div class="ml-6">
                <div class="flex items-center">
                  <h1 class="text-2xl font-bold text-gray-900" x-text="$store.auth.user?.first_name + ' ' + $store.auth.user?.last_name"></h1>
                  <span class="ml-3 inline-flex items-center px-3 py-0.5 rounded-full text-sm font-medium bg-green-100 text-green-800">
                    <svg class="-ml-1 mr-1.5 h-2 w-2 text-green-400" fill="currentColor" viewBox="0 0 8 8">
                      <circle cx="4" cy="4" r="3" />
                    </svg>
                    Active
                  </span>
                </div>
                <p class="text-sm text-gray-600 mt-1" x-text="$store.auth.user?.email"></p>
                <p class="text-sm text-gray-500 mt-1">
                  <span>Member since </span>
                  <span x-text="$store.auth.user?.created_at ? new Date($store.auth.user.created_at).toLocaleDateString() : 'Recently'"></span>
                </p>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="mt-6 flex space-x-3 md:mt-0 md:ml-4">
            <button type="button"
                    class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
                    @click="startEdit('personal')"
                    x-show="!editMode">
              <svg class="-ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
              </svg>
              Edit Profile
            </button>

            <button type="button"
                    class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
                    @click="saveProfile()"
                    x-show="editMode">
              <svg class="-ml-1 mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Save Changes
            </button>

            <button type="button"
                    class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
                    @click="cancelEdit()"
                    x-show="editMode">
              Cancel
            </button>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
        <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">

          <!-- Left Column - Personal Information -->
          <div class="lg:col-span-2">
            <div class="space-y-8">

              <!-- Personal Information Card -->
              <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                  <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg leading-6 font-medium text-gray-900">Personal Information</h3>
                    <button type="button"
                            class="inline-flex items-center px-3 py-1 border border-transparent text-sm leading-4 font-medium rounded-md text-primary-700 bg-primary-100 hover:bg-primary-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
                            @click="startEdit('personal')"
                            x-show="!editMode || editingSection !== 'personal'">
                      Edit
                    </button>
                  </div>

                  <!-- View Mode -->
                  <div x-show="!editMode || editingSection !== 'personal'">
                    <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                      <div>
                        <dt class="text-sm font-medium text-gray-500">First name</dt>
                        <dd class="mt-1 text-sm text-gray-900" x-text="$store.auth.user?.first_name || 'Not set'"></dd>
                      </div>

                      <div>
                        <dt class="text-sm font-medium text-gray-500">Last name</dt>
                        <dd class="mt-1 text-sm text-gray-900" x-text="$store.auth.user?.last_name || 'Not set'"></dd>
                      </div>

                      <div class="sm:col-span-2">
                        <dt class="text-sm font-medium text-gray-500">Email address</dt>
                        <dd class="mt-1 text-sm text-gray-900" x-text="$store.auth.user?.email || 'Not set'"></dd>
                      </div>

                      <div>
                        <dt class="text-sm font-medium text-gray-500">Phone number</dt>
                        <dd class="mt-1 text-sm text-gray-900" x-text="$store.auth.user?.phone || 'Not set'"></dd>
                      </div>

                      <div>
                        <dt class="text-sm font-medium text-gray-500">Time zone</dt>
                        <dd class="mt-1 text-sm text-gray-900" x-text="$store.auth.user?.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone"></dd>
                      </div>
                    </dl>
                  </div>

                  <!-- Edit Mode -->
                  <div x-show="editMode && editingSection === 'personal'">
                    <div class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                      <div>
                        <label for="first_name" class="block text-sm font-medium text-gray-700">First name</label>
                        <input type="text"
                               name="first_name"
                               id="first_name"
                               class="form-input mt-1"
                               x-model="tempUserData.first_name">
                      </div>

                      <div>
                        <label for="last_name" class="block text-sm font-medium text-gray-700">Last name</label>
                        <input type="text"
                               name="last_name"
                               id="last_name"
                               class="form-input mt-1"
                               x-model="tempUserData.last_name">
                      </div>

                      <div class="sm:col-span-2">
                        <label for="email" class="block text-sm font-medium text-gray-700">Email address</label>
                        <input type="email"
                               name="email"
                               id="email"
                               class="form-input mt-1"
                               x-model="tempUserData.email">
                      </div>

                      <div>
                        <label for="phone" class="block text-sm font-medium text-gray-700">Phone number</label>
                        <input type="tel"
                               name="phone"
                               id="phone"
                               class="form-input mt-1"
                               x-model="tempUserData.phone">
                      </div>

                      <div>
                        <label for="timezone" class="block text-sm font-medium text-gray-700">Time zone</label>
                        <select name="timezone"
                                id="timezone"
                                class="form-select mt-1"
                                x-model="tempUserData.timezone">
                          <option value="UTC">UTC</option>
                          <option value="America/New_York">Eastern Time</option>
                          <option value="America/Chicago">Central Time</option>
                          <option value="America/Denver">Mountain Time</option>
                          <option value="America/Los_Angeles">Pacific Time</option>
                          <option value="Europe/London">London</option>
                          <option value="Europe/Berlin">Berlin</option>
                          <option value="Asia/Tokyo">Tokyo</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Account Security -->
              <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                  <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg leading-6 font-medium text-gray-900">Account Security</h3>
                  </div>

                  <div class="space-y-6">
                    <!-- Password Section -->
                    <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                      <div>
                        <h4 class="text-sm font-medium text-gray-900">Password</h4>
                        <p class="text-sm text-gray-500">Last updated 30 days ago</p>
                      </div>
                      <button type="button"
                              class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                        Change Password
                      </button>
                    </div>

                    <!-- Two-Factor Authentication -->
                    <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                      <div>
                        <h4 class="text-sm font-medium text-gray-900">Two-factor authentication</h4>
                        <p class="text-sm text-gray-500">Add an extra layer of security to your account</p>
                      </div>
                      <div class="flex items-center space-x-3">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                          Disabled
                        </span>
                        <button type="button"
                                class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                          Enable
                        </button>
                      </div>
                    </div>

                    <!-- API Keys -->
                    <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                      <div>
                        <h4 class="text-sm font-medium text-gray-900">API Keys</h4>
                        <p class="text-sm text-gray-500">Manage your API access keys</p>
                      </div>
                      <button type="button"
                              class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                        Manage Keys
                      </button>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- Right Column - Activity & Preferences -->
          <div class="space-y-8">

            <!-- Activity Summary -->
            <div class="bg-white shadow rounded-lg">
              <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Activity Summary</h3>

                <div class="space-y-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <div class="flex-shrink-0">
                        <div class="h-8 w-8 bg-primary-100 rounded-full flex items-center justify-center">
                          <svg class="h-4 w-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                          </svg>
                        </div>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm font-medium text-gray-900">Collections</p>
                        <p class="text-xs text-gray-500">Total created</p>
                      </div>
                    </div>
                    <div class="text-2xl font-bold text-gray-900">12</div>
                  </div>

                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <div class="flex-shrink-0">
                        <div class="h-8 w-8 bg-green-100 rounded-full flex items-center justify-center">
                          <svg class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                        </div>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm font-medium text-gray-900">Operations</p>
                        <p class="text-xs text-gray-500">Successfully completed</p>
                      </div>
                    </div>
                    <div class="text-2xl font-bold text-gray-900">247</div>
                  </div>

                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <div class="flex-shrink-0">
                        <div class="h-8 w-8 bg-blue-100 rounded-full flex items-center justify-center">
                          <svg class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                        </div>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm font-medium text-gray-900">Last Active</p>
                        <p class="text-xs text-gray-500">Current session</p>
                      </div>
                    </div>
                    <div class="text-sm font-medium text-gray-900">Now</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Preferences -->
            <div class="bg-white shadow rounded-lg">
              <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Preferences</h3>

                <div class="space-y-4">
                  <!-- Email Notifications -->
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-medium text-gray-900">Email notifications</p>
                      <p class="text-xs text-gray-500">Receive updates about your collections</p>
                    </div>
                    <div class="flex items-center">
                      <button type="button"
                              class="bg-primary-600 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2"
                              role="switch"
                              aria-checked="true">
                        <span class="translate-x-5 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
                      </button>
                    </div>
                  </div>

                  <!-- Push Notifications -->
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-medium text-gray-900">Push notifications</p>
                      <p class="text-xs text-gray-500">Get notified of important events</p>
                    </div>
                    <div class="flex items-center">
                      <button type="button"
                              class="bg-gray-200 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2"
                              role="switch"
                              aria-checked="false">
                        <span class="translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
                      </button>
                    </div>
                  </div>

                  <!-- Weekly Reports -->
                  <div class="flex items-center justify-between">
                    <div>
                      <p class="text-sm font-medium text-gray-900">Weekly reports</p>
                      <p class="text-xs text-gray-500">Summary of your account activity</p>
                    </div>
                    <div class="flex items-center">
                      <button type="button"
                              class="bg-primary-600 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2"
                              role="switch"
                              aria-checked="true">
                        <span class="translate-x-5 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Connected Accounts Section -->
            <div class="bg-white shadow rounded-lg" x-data="{
                  connectedAccounts: [],
                  passkeys: [],
                  loading: false,
                  error: null,

                  async loadConnectedAccounts() {
                    this.loading = true;
                    this.error = null;
                    try {
                      const auth = Alpine.store('auth');

                      // Load connected accounts
                      const accountsResponse = await fetch('/api/auth/connected-accounts', {
                        headers: auth.getAuthHeaders(),
                      });

                      if (accountsResponse.ok) {
                        const accountsData = await accountsResponse.json();
                        this.connectedAccounts = accountsData.connected_accounts;
                      } else {
                        throw new Error('Failed to load connected accounts');
                      }

                      // Load PassKeys
                      const passkeysResponse = await fetch('/api/auth/passkeys', {
                        headers: auth.getAuthHeaders(),
                      });

                      if (passkeysResponse.ok) {
                        const passkeysData = await passkeysResponse.json();
                        this.passkeys = passkeysData.passkeys;
                      } else {
                        throw new Error('Failed to load PassKeys');
                      }

                    } catch (error) {
                      console.error('Failed to load connected accounts:', error);
                      this.error = error.message;
                    } finally {
                      this.loading = false;
                    }
                  },

                  async disconnectAccount(accountId) {
                    if (!confirm('Are you sure you want to disconnect this account?')) return;

                    try {
                      const auth = Alpine.store('auth');
                      const response = await fetch(`/api/auth/connected-accounts/${accountId}`, {
                        method: 'DELETE',
                        headers: auth.getAuthHeaders(),
                      });

                      if (response.ok) {
                        await this.loadConnectedAccounts();
                        console.log('Account disconnected successfully');
                      } else {
                        const error = await response.json();
                        throw new Error(error.detail || 'Failed to disconnect account');
                      }
                    } catch (error) {
                      console.error('Failed to disconnect account:', error);
                      this.error = error.message;
                    }
                  },

                  async deletePassKey(passkeyId) {
                    if (!confirm('Are you sure you want to delete this PassKey?')) return;

                    try {
                      const auth = Alpine.store('auth');
                      const response = await fetch(`/api/auth/passkeys/${passkeyId}`, {
                        method: 'DELETE',
                        headers: auth.getAuthHeaders(),
                      });

                      if (response.ok) {
                        await this.loadConnectedAccounts();
                        console.log('PassKey deleted successfully');
                      } else {
                        const error = await response.json();
                        throw new Error(error.detail || 'Failed to delete PassKey');
                      }
                    } catch (error) {
                      console.error('Failed to delete PassKey:', error);
                      this.error = error.message;
                    }
                  },

                  async addPassKey() {
                    try {
                      // Check if WebAuthn is supported
                      if (!window.PublicKeyCredential) {
                        throw new Error('WebAuthn is not supported in this browser');
                      }

                      this.loading = true;
                      this.error = null;

                      // Get registration challenge from server
                      const auth = Alpine.store('auth');
                      const challengeResponse = await fetch('/api/auth/passkeys/registration-challenge', {
                        method: 'POST',
                        headers: {
                          ...auth.getAuthHeaders(),
                          'Content-Type': 'application/json',
                        },
                      });

                      if (!challengeResponse.ok) {
                        const error = await challengeResponse.json();
                        throw new Error(error.detail || 'Failed to get registration challenge');
                      }

                      const challengeData = await challengeResponse.json();

                      // Convert base64url strings to ArrayBuffers
                      const challenge = Uint8Array.from(atob(challengeData.challenge.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));
                      const userId = Uint8Array.from(atob(challengeData.user.id.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));

                      // Create WebAuthn credential
                      const credential = await navigator.credentials.create({
                        publicKey: {
                          challenge: challenge,
                          rp: challengeData.rp,
                          user: {
                            ...challengeData.user,
                            id: userId,
                          },
                          pubKeyCredParams: challengeData.pubKeyCredParams,
                          authenticatorSelection: challengeData.authenticatorSelection,
                          timeout: challengeData.timeout || 60000,
                          attestation: challengeData.attestation || 'direct'
                        }
                      });

                      if (!credential) {
                        throw new Error('PassKey registration was cancelled');
                      }

                      // Convert credential response to format expected by server
                      const registrationData = {
                        id: credential.id,
                        rawId: btoa(String.fromCharCode(...new Uint8Array(credential.rawId))),
                        response: {
                          clientDataJSON: btoa(String.fromCharCode(...new Uint8Array(credential.response.clientDataJSON))),
                          attestationObject: btoa(String.fromCharCode(...new Uint8Array(credential.response.attestationObject))),
                        },
                        type: credential.type,
                      };

                      // Send credential to server for verification
                      const verificationResponse = await fetch('/api/auth/passkeys/verify-registration', {
                        method: 'POST',
                        headers: {
                          ...auth.getAuthHeaders(),
                          'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(registrationData),
                      });

                      if (!verificationResponse.ok) {
                        const error = await verificationResponse.json();
                        throw new Error(error.detail || 'Failed to verify PassKey registration');
                      }

                      const result = await verificationResponse.json();
                      console.log('PassKey registered successfully:', result);

                      // Reload the connected accounts to show the new PassKey
                      await this.loadConnectedAccounts();

                    } catch (error) {
                      console.error('Failed to add PassKey:', error);
                      this.error = error.message;
                    } finally {
                      this.loading = false;
                    }
                  }
                }"
                x-init="loadConnectedAccounts()">
              <div class="px-4 py-5 sm:p-6">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg leading-6 font-medium text-gray-900">Connected Accounts</h3>
                  <button type="button"
                          @click="loadConnectedAccounts()"
                          class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                    <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                    Refresh
                  </button>
                </div>

                  <div x-show="loading" class="text-center py-4">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600 mx-auto"></div>
                    <p class="text-sm text-gray-500 mt-2">Loading connected accounts...</p>
                  </div>

                  <div x-show="error" class="rounded-md bg-red-50 p-4 mb-4">
                    <div class="flex">
                      <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                        </svg>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm text-red-800" x-text="error"></p>
                      </div>
                    </div>
                  </div>

                  <div x-show="!loading && !error">
                    <!-- OAuth Providers -->
                    <div class="mb-6">
                      <h4 class="text-sm font-medium text-gray-900 mb-3">OAuth Providers</h4>

                      <div x-show="connectedAccounts.length === 0" class="text-center py-6 text-gray-500">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                        </svg>
                        <p class="mt-2 text-sm">No connected accounts</p>
                        <p class="text-xs text-gray-400">Connect OAuth providers for easy sign-in</p>
                      </div>

                      <div x-show="connectedAccounts.length > 0" class="space-y-3">
                        <template x-for="account in connectedAccounts" :key="account.id">
                          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                            <div class="flex items-center">
                              <div class="flex-shrink-0">
                                <div class="h-10 w-10 rounded-full bg-gray-100 flex items-center justify-center"
                                     :class="{
                                       'bg-gray-900': account.provider_type === 'github',
                                       'bg-blue-600': account.provider_type === 'google',
                                       'bg-orange-500': account.provider_type === 'gitlab'
                                     }">
                                  <span class="text-white font-semibold text-sm"
                                        x-text="account.provider_type.charAt(0).toUpperCase()"></span>
                                </div>
                              </div>
                              <div class="ml-4">
                                <div class="flex items-center">
                                  <p class="text-sm font-medium text-gray-900 capitalize" x-text="account.provider_type"></p>
                                  <span x-show="account.is_primary"
                                        class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                    Primary
                                  </span>
                                  <span x-show="account.is_verified"
                                        class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                                    Verified
                                  </span>
                                </div>
                                <p class="text-sm text-gray-500" x-text="account.provider_email || account.display_name"></p>
                                <p class="text-xs text-gray-400">
                                  Connected <span x-text="new Date(account.first_connected_at).toLocaleDateString()"></span>
                                  <span x-show="account.last_used_at">
                                    • Last used <span x-text="new Date(account.last_used_at).toLocaleDateString()"></span>
                                  </span>
                                </p>
                              </div>
                            </div>
                            <div class="flex items-center">
                              <button type="button"
                                      @click="disconnectAccount(account.id)"
                                      class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v7.5A2.25 2.25 0 005.25 18h8.25A2.25 2.25 0 0015.75 15.75v-7.5A2.25 2.25 0 0013.5 6zM13.5 6a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25v7.5A2.25 2.25 0 0118 15.75h-2.25a2.25 2.25 0 01-2.25-2.25V6z" />
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Disconnect
                              </button>
                            </div>
                          </div>
                        </template>
                      </div>
                    </div>

                    <!-- PassKeys -->
                    <div>
                      <div class="flex items-center justify-between mb-3">
                        <h4 class="text-sm font-medium text-gray-900">PassKeys</h4>
                        <button type="button"
                                @click="addPassKey()"
                                :disabled="loading"
                                class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed">
                          <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                          </svg>
                          Add PassKey
                        </button>
                      </div>

                      <div x-show="passkeys.length === 0" class="text-center py-6 text-gray-500">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                        </svg>
                        <p class="mt-2 text-sm">No PassKeys registered</p>
                        <p class="text-xs text-gray-400">Add PassKeys for secure transaction confirmations</p>
                      </div>

                      <div x-show="passkeys.length > 0" class="space-y-3">
                        <template x-for="passkey in passkeys" :key="passkey.id">
                          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
                            <div class="flex items-center">
                              <div class="flex-shrink-0">
                                <div class="h-10 w-10 rounded-full bg-green-100 flex items-center justify-center">
                                  <svg class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                                  </svg>
                                </div>
                              </div>
                              <div class="ml-4">
                                <div class="flex items-center">
                                  <p class="text-sm font-medium text-gray-900" x-text="passkey.name"></p>
                                  <span x-show="!passkey.is_active"
                                        class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                                    Inactive
                                  </span>
                                </div>
                                <p class="text-sm text-gray-500" x-text="passkey.description || 'No description'"></p>
                                <p class="text-xs text-gray-400">
                                  <span class="capitalize" x-text="passkey.authenticator_type.replace('_', ' ')"></span>
                                  • Added <span x-text="new Date(passkey.created_at).toLocaleDateString()"></span>
                                  <span x-show="passkey.last_used_at">
                                    • Last used <span x-text="new Date(passkey.last_used_at).toLocaleDateString()"></span>
                                  </span>
                                </p>
                              </div>
                            </div>
                            <div class="flex items-center">
                              <button type="button"
                                      @click="deletePassKey(passkey.id)"
                                      class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                                <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                </svg>
                                Delete
                              </button>
                            </div>
                          </div>
                        </template>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Authentication Sessions Section -->
            <div class="bg-white shadow rounded-lg">
              <div class="px-4 py-5 sm:p-6">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-lg leading-6 font-medium text-gray-900">Authentication Sessions</h3>
                  <div class="flex space-x-3">
                    <button type="button"
                            @click="loadSessions()"
                            class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                      <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                      </svg>
                      Refresh
                    </button>
                    <button type="button"
                            @click="revokeAllSessions()"
                            class="inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                      <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1012.728 0M12 3v9" />
                      </svg>
                      Revoke All
                    </button>
                  </div>
                </div>

                <div x-data="{
                  sessions: [],
                  loading: false,
                  error: null,
                  activeCount: 0,

                  async loadSessions() {
                    this.loading = true;
                    this.error = null;
                    try {
                      const auth = Alpine.store('auth');
                      const response = await fetch('/api/auth/sessions?include_inactive=true', {
                        headers: auth.getAuthHeaders(),
                      });

                      if (response.ok) {
                        const data = await response.json();
                        this.sessions = data.sessions;
                        this.activeCount = data.active_count;
                      } else {
                        throw new Error('Failed to load sessions');
                      }
                    } catch (error) {
                      console.error('Failed to load sessions:', error);
                      this.error = error.message;
                    } finally {
                      this.loading = false;
                    }
                  },

                  async revokeSession(sessionId) {
                    if (!confirm('Are you sure you want to revoke this session?')) return;

                    try {
                      const auth = Alpine.store('auth');
                      const response = await fetch(`/api/auth/sessions/${sessionId}`, {
                        method: 'DELETE',
                        headers: auth.getAuthHeaders(),
                      });

                      if (response.ok) {
                        await this.loadSessions();
                        console.log('Session revoked successfully');
                      } else {
                        const error = await response.json();
                        throw new Error(error.detail || 'Failed to revoke session');
                      }
                    } catch (error) {
                      console.error('Failed to revoke session:', error);
                      this.error = error.message;
                    }
                  },

                  async revokeAllSessions() {
                    if (!confirm('Are you sure you want to revoke all sessions? You will be logged out of other devices.')) return;

                    try {
                      const auth = Alpine.store('auth');
                      const response = await fetch('/api/auth/sessions/all', {
                        method: 'DELETE',
                        headers: auth.getAuthHeaders(),
                      });

                      if (response.ok) {
                        await this.loadSessions();
                        console.log('All sessions revoked successfully');
                      } else {
                        const error = await response.json();
                        throw new Error(error.detail || 'Failed to revoke all sessions');
                      }
                    } catch (error) {
                      console.error('Failed to revoke all sessions:', error);
                      this.error = error.message;
                    }
                  }
                }"
                x-init="loadSessions()">

                  <div x-show="loading" class="text-center py-4">
                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600 mx-auto"></div>
                    <p class="text-sm text-gray-500 mt-2">Loading sessions...</p>
                  </div>

                  <div x-show="error" class="rounded-md bg-red-50 p-4 mb-4">
                    <div class="flex">
                      <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                        </svg>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm text-red-800" x-text="error"></p>
                      </div>
                    </div>
                  </div>

                  <div x-show="!loading && !error">
                    <div x-show="activeCount > 0" class="mb-4 p-3 bg-green-50 rounded-lg border border-green-200">
                      <p class="text-sm text-green-800">
                        <span class="font-medium" x-text="activeCount"></span> active session<span x-show="activeCount !== 1">s</span>
                      </p>
                    </div>

                    <div x-show="sessions.length === 0" class="text-center py-6 text-gray-500">
                      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <p class="mt-2 text-sm">No authentication sessions</p>
                    </div>

                    <div x-show="sessions.length > 0" class="space-y-3">
                      <template x-for="session in sessions" :key="session.id">
                        <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg"
                             :class="{ 'border-green-300 bg-green-50': session.is_active && !session.is_expired }">
                          <div class="flex items-center">
                            <div class="flex-shrink-0">
                              <div class="h-10 w-10 rounded-full flex items-center justify-center"
                                   :class="{
                                     'bg-green-100': session.is_active && !session.is_expired,
                                     'bg-gray-100': !session.is_active || session.is_expired,
                                     'bg-red-100': session.is_suspicious
                                   }">
                                <svg class="h-5 w-5"
                                     :class="{
                                       'text-green-600': session.is_active && !session.is_expired,
                                       'text-gray-400': !session.is_active || session.is_expired,
                                       'text-red-600': session.is_suspicious
                                     }"
                                     fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                              </div>
                            </div>
                            <div class="ml-4">
                              <div class="flex items-center">
                                <p class="text-sm font-medium text-gray-900" x-text="session.ip_address"></p>
                                <span x-show="session.is_active && !session.is_expired"
                                      class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                  Active
                                </span>
                                <span x-show="session.is_expired"
                                      class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800">
                                  Expired
                                </span>
                                <span x-show="session.is_suspicious"
                                      class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">
                                  Suspicious
                                </span>
                              </div>
                              <p class="text-sm text-gray-500 capitalize" x-text="session.login_method + (session.provider_type ? ' (' + session.provider_type + ')' : '')"></p>
                              <p class="text-xs text-gray-400">
                                Started <span x-text="new Date(session.created_at).toLocaleString()"></span>
                                • Last activity <span x-text="new Date(session.last_activity_at).toLocaleString()"></span>
                                <span x-show="session.duration_minutes">
                                  • Duration: <span x-text="session.duration_minutes"></span> minutes
                                </span>
                              </p>
                              <p x-show="session.user_agent" class="text-xs text-gray-400 mt-1 truncate max-w-md" x-text="session.user_agent"></p>
                            </div>
                          </div>
                          <div class="flex items-center">
                            <button x-show="session.is_active"
                                    type="button"
                                    @click="revokeSession(session.id)"
                                    class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                              <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.636 5.636a9 9 0 1012.728 0M12 3v9" />
                              </svg>
                              Revoke
                            </button>
                            <span x-show="!session.is_active" class="text-sm text-gray-500">
                              Ended: <span x-text="session.end_reason || 'Unknown'"></span>
                            </span>
                          </div>
                        </div>
                      </template>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Danger Zone -->
            <div class="bg-white shadow rounded-lg border border-red-200">
              <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg leading-6 font-medium text-red-900 mb-4">Danger Zone</h3>

                <div class="space-y-4">
                  <div class="p-4 bg-red-50 rounded-lg border border-red-200">
                    <div class="flex">
                      <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                        </svg>
                      </div>
                      <div class="ml-3 flex-1">
                        <h4 class="text-sm font-medium text-red-800">Delete Account</h4>
                        <p class="text-sm text-red-700 mt-1">
                          Once you delete your account, there is no going back. Please be certain.
                        </p>
                        <div class="mt-4">
                          <button type="button"
                                  class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            Delete Account
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>