          </div>
        `}
      </div>
    `;

    // Timestamps
    html += `
      <div>
        <h4 class="text-sm font-medium text-gray-900 mb-3">Timestamps</h4>
        <dl class="grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2">
